---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Admin Dashboard">
<h1 class="page-title">🛠️ Admin Login</h1>

<section class="glass-card" id="loginSection">
<h2>Masuk sebagai Admin</h2>
<form id="loginForm">
<div class="field">
<label for="username">Username</label>
<input type="text" id="username" required placeholder="Masukkan username" />
</div>
<div class="field">
<label for="password">Password</label>
<input type="password" id="password" required placeholder="••••••••" />
</div>
<button type="submit" id="loginBtn">Masuk</button>
<p class="hint">Demo: <strong>admin</strong> / <strong>admin123</strong> atau <strong>teacher</strong> / <strong>teacher123</strong></p>
</form>
<div id="loginMessage" class="message"></div>
</section>

<section class="glass-card" id="adminPanel" style="display: none;">
<h2>Tambah Pengumuman</h2>
<form id="announcementForm">
<div class="field">
<label for="title">Judul</label>
<input type="text" id="title" required placeholder="Contoh: Libur Lebaran" />
</div>
<div class="field">
<label for="content">Isi Pengumuman</label>
<textarea id="content" required placeholder="Tulis isi pengumuman di sini..."></textarea>
</div>
<button type="submit" id="submitBtn">Kirim Pengumuman</button>
<button type="button" id="logoutBtn" class="secondary">Logout</button>
</form>
<div id="message" class="message"></div>
</section>

<script>
const loginSection = document.getElementById('loginSection')!;
const adminPanel = document.getElementById('adminPanel')!;
const loginForm = document.getElementById('loginForm') as HTMLFormElement;
const announcementForm = document.getElementById('announcementForm') as HTMLFormElement;
const loginMessage = document.getElementById('loginMessage') as HTMLDivElement;
const messageDiv = document.getElementById('message') as HTMLDivElement;
const logoutBtn = document.getElementById('logoutBtn') as HTMLButtonElement;

const token = localStorage.getItem('admin_token');
const role = localStorage.getItem('admin_role');

if (token) {
loginSection.style.display = 'none';
adminPanel.style.display = 'block';
}

loginForm?.addEventListener('submit', async (e: Event) => {
e.preventDefault();
const username = (document.getElementById('username') as HTMLInputElement).value;
const password = (document.getElementById('password') as HTMLInputElement).value;

try {
const res = await fetch('/api/auth/login', {
method: 'POST',
headers: { 'Content-Type': 'application/json' },
body: JSON.stringify({ username, password })
});

const data = await res.json();
if (res.ok) {
localStorage.setItem('admin_token', data.token);
localStorage.setItem('admin_role', data.role);
loginSection.style.display = 'none';
adminPanel.style.display = 'block';
loginMessage.textContent = '';
} else {
loginMessage.textContent = `Error: ${data.error || 'Gagal login'}`;
loginMessage.className = 'message error';
}
} catch {
loginMessage.textContent = 'Error: Gagal terhubung ke server';
loginMessage.className = 'message error';
}
});

announcementForm?.addEventListener('submit', async (e: Event) => {
e.preventDefault();
const title = (document.getElementById('title') as HTMLInputElement).value;
const content = (document.getElementById('content') as HTMLTextAreaElement).value;
const token = localStorage.getItem('admin_token');

if (!token) {
messageDiv.textContent = 'Error: Session habis, silakan login ulang';
messageDiv.className = 'message error';
loginSection.style.display = 'block';
adminPanel.style.display = 'none';
return;
}

try {
const res = await fetch('/api/announcements', {
method: 'POST',
headers: {
'Content-Type': 'application/json',
'Authorization': `Bearer ${token}`
},
body: JSON.stringify({ title, content })
});

if (res.ok) {
messageDiv.textContent = '✅ Pengumuman berhasil dikirim!';
messageDiv.className = 'message success';
announcementForm.reset();
} else {
const err = await res.json();
messageDiv.textContent = `Error: ${err.error || 'Gagal mengirim'}`;
messageDiv.className = 'message error';
}
} catch {
messageDiv.textContent = 'Error: Gagal terhubung ke server';
messageDiv.className = 'message error';
}
});

logoutBtn?.addEventListener('click', () => {
localStorage.removeItem('admin_token');
localStorage.removeItem('admin_role');
loginSection.style.display = 'block';
adminPanel.style.display = 'none';
});
</script>

<style>
.page-title { color: #1e3c72; margin-bottom: 1.5rem; }
.glass-card {
background: rgba(255, 255, 255, 0.85);
backdrop-filter: blur(12px);
-webkit-backdrop-filter: blur(12px);
border: 1px solid rgba(255, 255, 255, 0.5);
border-radius: 1rem;
padding: 2rem;
margin-bottom: 1.5rem;
box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
}
.field { margin-bottom: 1rem; display: flex; flex-direction: column; }
label { font-weight: 700; margin-bottom: 0.4rem; color: #2c3e50; font-size: 0.9rem; }
input[type="text"], input[type="password"], textarea {
padding: 0.75rem 1rem;
border: 1px solid rgba(0, 0, 0, 0.15);
border-radius: 0.75rem;
font-family: inherit;
font-size: 1rem;
background: rgba(255, 255, 255, 0.6);
transition: border-color 0.2s, box-shadow 0.2s;
}
input:focus, textarea:focus {
outline: none;
border-color: #2a5298;
box-shadow: 0 0 0 3px rgba(42, 82, 152, 0.15);
}
textarea { height: 120px; resize: vertical; }
button {
background: #1e3c72;
color: white;
padding: 0.75rem 1.5rem;
border: none;
border-radius: 0.75rem;
cursor: pointer;
font-weight: 700;
font-size: 1rem;
transition: background 0.2s, transform 0.1s;
}
button:hover { background: #2a5298; }
button:active { transform: scale(0.98); }
button.secondary {
background: transparent;
color: #1e3c72;
border: 2px solid #1e3c72;
margin-left: 0.5rem;
}
button.secondary:hover { background: rgba(30, 60, 114, 0.08); }
.message {
margin-top: 1rem;
padding: 1rem;
border-radius: 0.75rem;
display: none;
}
.message:not(:empty) { display: block; }
.success { background: #d4edda; color: #155724; border: 1px solid #c3e6cb; }
.error { background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }
.hint { font-size: 0.85rem; color: #666; margin-top: 1rem; }
h2 { color: #1e3c72; margin-top: 0; }
</style>
</BaseLayout>
