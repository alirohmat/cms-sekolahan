---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const announcements = await getCollection('announcements');
announcements.sort((a, b) => new Date(b.data.date) - new Date(a.data.date));
const latestAnnouncements = announcements.slice(0, 5);
---

<BaseLayout title="Beranda">
  <section>
    <h1>Selamat Datang di Portal Sekolah</h1>
    <p>Sistem Informasi Manajemen Sekolah berbasis web.</p>
  </section>

  <section>
    <h2>Pengumuman Terbaru</h2>
    {latestAnnouncements.length > 0 ? (
      <ul>
        {latestAnnouncements.map(item => (
          <li>
            <article>
              <h3>{item.data.title}</h3>
              <p>{item.data.content}</p>
              <small>{new Date(item.data.date).toLocaleDateString('id-ID')}</small>
            </article>
          </li>
        ))}
      </ul>
    ) : (
      <p>Belum ada pengumuman.</p>
    )}
  </section>
</BaseLayout>


