---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="CMS Web Sekolah" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title} | CMS Sekolah</title>
<style is:global>
  *, *::before, *::after { box-sizing: border-box; }
  body {
    font-family: system-ui, -apple-system, sans-serif;
    line-height: 1.6;
    margin: 0;
    padding: 0;
    background: linear-gradient(135deg, #1e3c72, #2a5298);
    color: #2c3e50;
    min-height: 100vh;
  }
  nav.floating-nav {
    position: fixed;
    top: 1rem;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 9999px;
    display: flex;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    z-index: 1000;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
  }
  nav.floating-nav a {
    color: white;
    text-decoration: none;
    font-weight: 600;
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    transition: background 0.2s;
    font-size: 0.95rem;
  }
  nav.floating-nav a:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  main {
    max-width: 900px;
    margin: 0 auto;
    padding: 5rem 1rem 2rem;
  }
  article, section {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 1rem;
    padding: 1.5rem 2rem;
    margin-bottom: 1.5rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  }
  h1, h2, h3 {
    color: #1e3c72;
  }
  a { color: #2a5298; }
  footer {
    text-align: center;
    padding: 2rem 1rem;
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.9rem;
  }
  @media (max-width: 640px) {
    main { padding: 4.5rem 0.75rem 1.5rem; }
    article, section { padding: 1rem 1.25rem; }
    nav.floating-nav { border-radius: 1rem; gap: 0.25rem; padding: 0.4rem; }
    nav.floating-nav a { padding: 0.4rem 0.6rem; font-size: 0.85rem; }
  }
</style>
	</head>
<body>
  <nav class="floating-nav">
    <a href="/">🏠 Beranda</a>
    <a href="/announcements">📋 Pengumuman</a>
    <a href="/admin">🛠️ Admin</a>
  </nav>
  <main>
    <slot />
  </main>
		<footer>
			&copy; {new Date().getFullYear()} CMS Web Sekolah - Flat-file Engine
		</footer>
	</body>
</html>
