---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="CMS Web Sekolah" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title} | CMS Sekolah</title>
		<style>
			body {
				font-family: system-ui, -apple-system, sans-serif;
				line-height: 1.6;
				margin: 0;
				padding: 0;
				background: #f4f4f9;
				color: #333;
			}
			header {
				background: #2c3e50;
				color: white;
				padding: 1rem 2rem;
				display: flex;
				justify-content: space-between;
				align-items: center;
			}
			nav a {
				color: white;
				text-decoration: none;
				margin-left: 1rem;
				font-weight: 500;
			}
			main {
				max-width: 800px;
				margin: 2rem auto;
				padding: 0 1rem;
			}
			footer {
				text-align: center;
				padding: 2rem;
				font-size: 0.9rem;
				color: #666;
			}
		</style>
	</head>
	<body>
		<header>
			<div class="logo"><strong>🏫 CMS Sekolah</strong></div>
			<nav>
				<a href="/">Beranda</a>
				<a href="/announcements">Pengumuman</a>
				<a href="/admin">Admin</a>
			</nav>
		</header>
		<main>
			<slot />
		</main>
		<footer>
			&copy; {new Date().getFullYear()} CMS Web Sekolah - Flat-file Engine
		</footer>
	</body>
</html>
